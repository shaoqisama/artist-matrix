# Artist Matrix environment configuration
# Copy to .env and adjust values as needed.

# Root directories
ARTIST_MATRIX_DATA_ROOT=./data
ARTIST_MATRIX_CACHE_ROOT=./.cache
# Optional: override the packaged domain or native specialist prompt directories
# ARTIST_MATRIX_PROMPTS_ROOT=/absolute/path/to/custom/prompts
# ARTIST_MATRIX_AGENT_PROMPTS_ROOT=/absolute/path/to/custom/prompts

# Native agent runtime (codex is the default; legacy keeps the classic/Rich TUI)
ARTIST_MATRIX_AGENT_RUNTIME=codex
# Optional: use a specific model instead of the Codex account default
# ARTIST_MATRIX_CODEX_MODEL=gpt-5.6-terra
# Optional: intentionally override the executable pinned by openai-codex
# ARTIST_MATRIX_CODEX_BIN=/absolute/path/to/codex
# Optional isolated runtime/authentication home and empty workspace
# ARTIST_MATRIX_CODEX_HOME=./.cache/codex-home
# ARTIST_MATRIX_CODEX_WORKSPACE=./.cache/codex-home/workspace
# Optional persistence locations (thread store defaults inside CODEX_HOME)
# ARTIST_MATRIX_CODEX_THREAD_STORE=./.cache/codex-home/agent_threads.json
# ARTIST_MATRIX_ACTION_ROOT=./data/actions

# Logging verbosity (DEBUG, INFO, WARNING, ERROR)
ARTIST_MATRIX_LOG_LEVEL=INFO

# Persona generation provider (stub, deepseek, claude)
# Example DeepSeek setup:
# ARTIST_MATRIX_PERSONA_PROVIDER=deepseek
# ARTIST_MATRIX_PERSONA_MODEL=deepseek-music-v1
# ARTIST_MATRIX_PERSONA_API_KEY=sk-deepseek-xxxxx
# ARTIST_MATRIX_PERSONA_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# ARTIST_MATRIX_PERSONA_LOG_DIR=./logs/deepseek
ARTIST_MATRIX_PERSONA_PROVIDER=stub
ARTIST_MATRIX_PERSONA_MODEL=persona-stub
# ARTIST_MATRIX_PERSONA_API_KEY=your-api-key-here

# Avatar generation provider (stub, sdxl, diffusion)
# Example SDXL setup:
# ARTIST_MATRIX_AVATAR_PROVIDER=sdxl
# ARTIST_MATRIX_AVATAR_MODEL=sdxl-lightning
# ARTIST_MATRIX_AVATAR_API_KEY=sk-sdxl-xxxxx
ARTIST_MATRIX_AVATAR_PROVIDER=stub
ARTIST_MATRIX_AVATAR_MODEL=sdxl-stub
# ARTIST_MATRIX_AVATAR_API_KEY=your-diffusion-api-key

# Creation Engine audio provider (stub, suno)
# Example Suno setup:
# ARTIST_MATRIX_CREATION_AUDIO_PROVIDER=suno
# ARTIST_MATRIX_CREATION_AUDIO_MODEL=V3_5
# ARTIST_MATRIX_CREATION_AUDIO_API_KEY=sk-suno-xxxxx
# ARTIST_MATRIX_CREATION_AUDIO_BASE_URL=https://api.sunoapi.org
# ARTIST_MATRIX_CREATION_AUDIO_CALLBACK_URL=https://artist-matrix.local/callback
# ARTIST_MATRIX_CREATION_AUDIO_LOG_DIR=./logs/suno
# ARTIST_MATRIX_CREATION_AUDIO_POLL_INTERVAL=5.0
# ARTIST_MATRIX_CREATION_AUDIO_TIMEOUT_SECONDS=420
ARTIST_MATRIX_CREATION_AUDIO_PROVIDER=stub
ARTIST_MATRIX_CREATION_AUDIO_MODEL=V3_5
